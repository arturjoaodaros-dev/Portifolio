# Copie para .env (não versionado). Ambas as variáveis são opcionais.

# URL pública, sem barra final. Ausente ou vazia = https://arturdaros.is-a.dev
# Alimenta canonical, og:url, og:image, sitemap.xml, robots.txt e llms.txt.
VITE_SITE_URL=https://arturdaros.is-a.dev

# Código do site no GoatCounter (a parte antes de ".goatcounter.com"). Vazio = analytics desligado.
VITE_GOATCOUNTER_CODE=
